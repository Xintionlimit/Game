{
  "name": "mori-courtyard",
  "version": "0.3.0",
  "private": true,
  "description": "《末日小院》手机 H5 游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:code": "npm run typecheck && npm run test && npm run build",
    "check": "npm run check:code && npm run test:e2e"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
